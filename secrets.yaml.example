wifi_ssid: "YourWifiSSID"
wifi_password: "YourWifiPassword"
ap_fallback_password: "fallbackpassword"
# Generate with: python3 -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
api_encryption_key: "REPLACE_WITH_32_BYTE_BASE64_KEY"
ota_password: "REPLACE_WITH_OTA_PASSWORD"

# WireGuard tunnel back to the network that hosts your ESPHome dashboard / Home Assistant,
# used when the device is out on a foreign Wi-Fi network. Generate a keypair with:
#   wg genkey | tee device.key | wg pubkey > device.pub
# address is this device's tunnel IP (from your WireGuard server's peer config), e.g. 10.10.0.5/32.
wireguard_address: "10.10.0.5"
wireguard_private_key: "REPLACE_WITH_DEVICE_WIREGUARD_PRIVATE_KEY"
wireguard_peer_endpoint: "your.wireguard.server.example.com"
wireguard_peer_public_key: "REPLACE_WITH_SERVER_WIREGUARD_PUBLIC_KEY"
